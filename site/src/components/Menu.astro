---
const items = [
  { label: 'about', href: '/about/', command: 'cat about.md' },
  { label: 'case studies', href: '/case-studies/', command: 'ls case-studies/' },
  { label: 'projects', href: '/projects/', command: 'ls projects/' },
  { label: 'cv.pdf', href: '/cv/', command: 'open cv.pdf' },
  { label: 'contact', href: '/contact/', command: 'cat contact.txt' },
];
const width = Math.max(...items.map((i) => i.label.length)) + 2;
---

<nav class="menu" aria-label="menu">
  <span class="menu-title" aria-hidden="true">menu</span>
  {
    items.map((item, i) => (
      <a class="item" href={item.href} data-command={item.command}>
        {` ${i + 1}. ${item.label.padEnd(width)}`}
      </a>
    ))
  }
</nav>

<style>
  .menu {
    position: relative;
    width: max-content;
    margin-top: 1em;
    padding: 0.35em 0.6em 0.45em;
    border: 1px solid var(--dim);
    font-size: 30px;
    line-height: 1;
  }

  .menu-title {
    position: absolute;
    top: -0.62em;
    left: 0.8em;
    padding: 0 0.3em;
    background: var(--bg);
    color: var(--dim);
    font-size: 20px;
  }

  .item {
    display: block;
    width: max-content;
    white-space: pre;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .menu {
      font-size: 24px;
    }
  }
</style>

---
// A plain, accessible form that works without JavaScript. With JS, contact.ts shows the
// same inputs one at a time as terminal prompts, with [ next ] and [ yes ]/[ no ] buttons.
---

<form class="contact-form" method="post" action="/api/contact" data-contact>
  <p class="field" data-step="name">
    <label for="c-name">name:</label>
    <input id="c-name" name="name" required maxlength="200" autocomplete="name" />
  </p>
  <p class="field" data-step="email">
    <label for="c-email">email:</label>
    <input id="c-email" name="email" type="email" required maxlength="254" autocomplete="email" />
  </p>
  <p class="field" data-step="message">
    <label for="c-message">message:</label>
    <textarea id="c-message" name="message" required maxlength="5000" rows="5"></textarea>
  </p>
  <p class="hp" aria-hidden="true">
    <label for="c-website">leave this empty</label>
    <input id="c-website" name="website" tabindex="-1" autocomplete="off" />
  </p>
  <p class="next hidden"><button type="button" data-next>[ next ]</button></p>
  <p class="field hidden" data-step="confirm">
    send? <button type="button" data-yes>[ yes ]</button> <button type="button" data-no>[ no ]</button>
  </p>
  <p class="submit"><button type="submit">[ send ]</button></p>
  <p class="status" data-status role="status" aria-live="polite"></p>
</form>

<style>
  .contact-form {
    margin-top: 1em;
    max-width: 62ch;
  }

  .field {
    display: flex;
    gap: 1ch;
    margin: 0 0 0.4em;
  }

  .field label {
    flex: none;
    color: var(--dim);
  }

  input,
  textarea,
  button {
    font: inherit;
    color: var(--fg);
    text-shadow: var(--glow);
    background: transparent;
    border: none;
    caret-color: var(--fg);
  }

  input,
  textarea {
    flex: 1;
    min-width: 0;
    padding: 0;
    outline: none;
    border-bottom: 1px solid var(--dim);
  }

  textarea {
    resize: vertical;
  }

  /* Terminal mode: the message starts as one line and grows as you type (where supported). */
  :global(.terminal) textarea {
    field-sizing: content;
    min-height: 1lh;
    max-height: 10lh;
  }

  input:focus,
  textarea:focus {
    border-bottom-color: var(--fg);
  }

  button {
    padding: 0;
    cursor: pointer;
  }

  button:focus {
    outline: none;
    background: var(--fg);
    color: var(--bg);
    text-shadow: none;
  }

  /* Honeypot: hidden from people, visible to naive bots. */
  .hp {
    position: absolute;
    left: -9999px;
  }

  .status:empty {
    display: none;
  }
</style>

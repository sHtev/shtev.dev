---
import { getCollection, render } from 'astro:content';
import Terminal from '../../layouts/Terminal.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { url, repo } = entry.data;
const { Content } = await render(entry);
---

<Terminal
  title={`${entry.data.title} · Steve Gilroy`}
  command={`cat projects/${entry.id}.md`}
  actions={[{ label: '[ back ]', href: '/projects/' }]}
>
  <div class="content" data-content>
    <Content />
    {url && <p>site: <a href={url}>{url.replace(/^https:\/\//, '')}</a></p>}
    {repo && <p>repo: <a href={repo}>{repo.replace(/^https:\/\//, '')}</a></p>}
  </div>
</Terminal>

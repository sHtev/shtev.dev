---
import { getEntry, render } from 'astro:content';
import Terminal from '../layouts/Terminal.astro';

const entry = (await getEntry('pages', 'about'))!;
const { Content } = await render(entry);
---

<Terminal title="About · Steve Gilroy" command={entry.data.command}>
  <div class="content" data-content><Content /></div>
</Terminal>

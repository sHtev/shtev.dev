---
import '@fontsource/vt323';
import '../styles/terminal.css';
import { ClientRouter } from 'astro:transitions';

export interface Action {
  label: string;
  href: string;
  download?: boolean;
}

interface Props {
  title: string;
  command?: string;
  actions?: Action[];
  /** Index of the action highlighted once the content has typed out; defaults to the last. */
  defaultAction?: number;
}

const { title, command = '' } = Astro.props;
const isHome = Astro.url.pathname === '/';
const actions = Astro.props.actions ?? (isHome ? [] : [{ label: '[ back ]', href: '/' }]);
const defaultAction = Astro.props.defaultAction ?? actions.length - 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <main>
      <p class="header dim">STEVE GILROY · platform / devops / ai</p>
      <p class="prompt">
        <span class="dim">shtev@dev:~$ </span><span data-prompt>{command}</span><span
          class="cursor"
          aria-hidden="true"> </span>
      </p>
      <slot />
    </main>
    <footer class="footer">
      <a href="https://github.com/sHtev" rel="me">github.com/shtev</a>
      <nav class="actions" aria-label="page actions" data-default-action={defaultAction}>
        {
          actions.map((a) => (
            <a href={a.href} download={a.download ? '' : undefined} data-action>
              {a.label}
            </a>
          ))
        }
      </nav>
    </footer>
  </body>
</html>

<script>
  import { navigate } from 'astro:transitions/client';
  import lines from '../content/prompt-lines.json';
  import { initLanding, initPage } from '../scripts/page';
  import { scanIn } from '../scripts/portrait';
  import { prefersReducedMotion } from '../scripts/typing';

  let teardown: (() => void) | undefined;

  // Runs on first load and after every client-side navigation.
  document.addEventListener('astro:page-load', () => {
    teardown?.();
    const reducedMotion = prefersReducedMotion();
    const promptEl = document.querySelector<HTMLElement>('[data-prompt]')!;
    const menuEl = document.querySelector<HTMLElement>('nav.menu');
    const actionsEl = document.querySelector<HTMLElement>('nav.actions')!;

    // The portrait is rendered in full for no-JS visitors; re-draw it row by row.
    const portrait = document.querySelector<HTMLElement>('[data-portrait] pre');
    const scan = portrait && scanIn(portrait, (portrait.textContent ?? '').split('\n'), { msPerRow: 18, reducedMotion });

    const page = menuEl
      ? initLanding({ promptEl, menuEl, lines, navigate, reducedMotion })
      : initPage({
          contentEl: document.querySelector<HTMLElement>('[data-content]'),
          actionsEl,
          defaultAction: Number(actionsEl.dataset.defaultAction ?? 0),
          navigate,
          reducedMotion,
          listEl: document.querySelector<HTMLElement>('[data-ls]'),
          promptEl,
        });
    teardown = () => {
      page.destroy();
      scan?.stop();
    };
  });
</script>
